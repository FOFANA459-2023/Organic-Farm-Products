{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ofp-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "WEB_ORIGIN": "http://localhost:3000",
    "ORDER_NOTIFY_EMAIL": "organicfarmproducts04@gmail.com",
    "EMAIL_FROM": "Organic Farm Products <orders@example.com>"
  },
  // Free Workers rate limiting: 5 public form submissions per IP per minute.
  "ratelimits": [
    { "name": "FORM_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
  // Secrets (wrangler secret put / .dev.vars): SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, TURNSTILE_SECRET_KEY, RESEND_API_KEY
}
